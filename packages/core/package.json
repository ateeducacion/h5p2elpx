{
  "name": "@ateeducacion/h5p2elpx-core",
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "Browser-safe H5P/ADC → eXeLearning .elpx conversion library",
  "homepage": "https://github.com/ateeducacion/h5p2elpx#readme",
  "bugs": {
    "url": "https://github.com/ateeducacion/h5p2elpx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ateeducacion/h5p2elpx.git",
    "directory": "packages/core"
  },
  "keywords": [
    "h5p",
    "exelearning",
    "elpx",
    "converter",
    "browser",
    "education"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun run scripts/fix-dts-extensions.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "fast-xml-parser": "^5.0.0",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
