{
  "name": "h5p2elpx-monorepo",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun test --parallel",
    "test:watch": "bun test --watch",
    "test:e2e": "bunx --bun playwright test",
    "test:e2e:ui": "bunx --bun playwright test --ui",
    "e2e:fetch-editor": "bun run scripts/fetch-exelearning-static.ts",
    "build-template": "bun run scripts/build-template.ts",
    "cli": "bun run packages/cli/src/index.ts",
    "web:dev": "bun run --cwd packages/web dev",
    "web:build": "bun run --cwd packages/web build",
    "lint": "bun lint && bun fmt --check",
    "fix": "bun lint --fix && bun fmt",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/bun": "latest",
    "jszip": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
